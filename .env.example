# =============================================================
# AgentDynamics App - Environment Variables
# Copy to .env.local (web/backend) and apps/mobile/.env (mobile)
# =============================================================

# ---- Database (Supabase Postgres) ----
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Auth providers ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""

# ---- AI providers (for AI handoff summaries, lead scoring) ----
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---- Cache ----
REDIS_URL="redis://localhost:6379"

# ---- Telephony / call data (AgentDynamics core integration) ----
# Replace with real upstream when wiring AgentDynamics call API.
AGENTDYNAMICS_API_BASE=""
AGENTDYNAMICS_API_KEY=""

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL="http://localhost:3000"
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
