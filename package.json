{
  "name": "agentdynamics-app",
  "private": true,
  "version": "0.1.0",
  "description": "Official AgentDynamics.ai web dashboard and mobile app for automotive dealerships.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @agentdynamics/web dev",
    "dev:mobile": "pnpm --filter @agentdynamics/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @agentdynamics/backend prisma:generate",
    "db:migrate": "pnpm --filter @agentdynamics/backend prisma:migrate",
    "db:seed": "pnpm --filter @agentdynamics/backend prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
